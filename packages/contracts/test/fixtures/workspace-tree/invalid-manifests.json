[
  {
    "name": "unsupported version",
    "expectedIssue": "workspace tree manifest version is unsupported",
    "manifest": {
      "version": 2,
      "hashAlgorithm": "sha256",
      "entries": []
    }
  },
  {
    "name": "unknown entry field",
    "expectedIssue": "workspace tree entries[0] contains unknown fields: mode",
    "manifest": {
      "version": 1,
      "hashAlgorithm": "sha256",
      "entries": [
        {
          "path": "README.md",
          "kind": "file",
          "executable": false,
          "size": 12,
          "contentSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "mode": "100644"
        }
      ]
    }
  },
  {
    "name": "malformed content digest",
    "expectedIssue": "workspace tree entries[0].contentSha256 must be a lowercase SHA-256 digest",
    "manifest": {
      "version": 1,
      "hashAlgorithm": "sha256",
      "entries": [
        {
          "path": "README.md",
          "kind": "file",
          "executable": false,
          "size": 12,
          "contentSha256": "not-a-digest"
        }
      ]
    }
  },
  {
    "name": "negative size",
    "expectedIssue": "workspace tree entries[0].size must be a non-negative safe integer",
    "manifest": {
      "version": 1,
      "hashAlgorithm": "sha256",
      "entries": [
        {
          "path": "README.md",
          "kind": "file",
          "executable": false,
          "size": -1,
          "contentSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  },
  {
    "name": "unsupported entry kind",
    "expectedIssue": "workspace tree entries[0].kind is unsupported",
    "manifest": {
      "version": 1,
      "hashAlgorithm": "sha256",
      "entries": [
        {
          "path": "linked-file",
          "kind": "symlink",
          "executable": false,
          "size": 10,
          "contentSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  }
]
